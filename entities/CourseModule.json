{
  "name": "CourseModule",
  "description": "A curriculum module belonging to a paid course.",
  "properties": {
    "course_id": { "type": "string", "description": "Parent course record id" },
    "course_slug": { "type": "string", "description": "Stable parent course slug" },
    "title": { "type": "string", "description": "Module title" },
    "description": { "type": "string", "description": "Module description" },
    "sort_order": { "type": "number", "description": "Display order within the course" },
    "is_published": { "type": "boolean", "description": "Whether the module appears in curriculum previews" }
  },
  "rls": {
    "read": {},
    "create": { "user_condition": { "role": "administrator" } },
    "update": { "user_condition": { "role": "administrator" } },
    "delete": { "user_condition": { "role": "administrator" } }
  }
}
